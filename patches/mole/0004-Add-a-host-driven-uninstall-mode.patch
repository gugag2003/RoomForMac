+@test "a host preview sizes each leftover once and marks a nested one as covered" {
+    command -v jq > /dev/null || skip "jq is required"
+    create_fixture_with_nested_leftover
+    install_uninstall_fakes
+    # No Spotlight size, so the engine measures the bundle with du -skP as below.
+    mole_test_fake_command mdls 'exit 1'
+    run_host_uninstall OVERRIDES="$OVERRIDES_FILE" MOLE_UNINSTALL_PREVIEW_ONLY=1 MAIN_ARGS=--dry-run
+    [ "$status" -eq 0 ]
+    run jq -r 'select(.type == "app") | (.leftover_items | length), ([.leftover_items[].path] == .leftovers)' "$EVENTS"
+    [ "$output" = "$(printf '4\ntrue')" ]
+    run jq -r --arg support "$SUPPORT" \
+        'select(.type == "app") | .leftover_items[0] | .size_kb == 0 and .size_known and .covered_by == $support' "$EVENTS"
+    [ "$output" = "true" ]
+    local leftover expected
+    for leftover in "$SUPPORT" "$CACHE" "$PREFS"; do
+        expected=$(/usr/bin/du -skP "$leftover" | awk '{print $1}')
+        [ "$expected" -gt 0 ]
+        run jq -r --arg path "$leftover" \
+            'select(.type == "app") | .leftover_items[] | select(.path == $path) | "\(.size_kb) \(.size_known) \(.covered_by)"' "$EVENTS"
+        [ "$output" = "$expected true null" ]
+    done
+    local bundle_kb
+    bundle_kb=$(/usr/bin/du -skP "$FIXTURE_APP" | awk '{print $1}')
+    run jq -r 'select(.type == "app")
+        | .size_kb - ([.leftover_items[] | select(.covered_by == null and .size_known) | .size_kb] | add)' "$EVENTS"
+    [ "$output" = "$bundle_kb" ]
+}
