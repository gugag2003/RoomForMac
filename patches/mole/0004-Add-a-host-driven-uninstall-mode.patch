             continue
         fi
 
@@ -1467,8 +1596,10 @@ _batch_scan_app_details() {
         if [[ -e "$info_plist" ]]; then
             exec_name=$(plutil -extract CFBundleExecutable raw "$info_plist" 2> /dev/null || echo "")
         fi
