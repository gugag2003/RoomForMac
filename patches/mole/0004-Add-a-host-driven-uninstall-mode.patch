+@test "a leftover whose size times out is unknown and the others keep their sizes" {
+    command -v jq > /dev/null || skip "jq is required"
+    local caches="$HOME/Library/Caches"
+    mkdir -p "$caches/FastA" "$caches/SlowCache" "$caches/FastB"
+    dd if=/dev/urandom of="$caches/FastA/a.bin" bs=1024 count=12 2> /dev/null
+    dd if=/dev/urandom of="$caches/SlowCache/s.bin" bs=1024 count=8 2> /dev/null
+    dd if=/dev/urandom of="$caches/FastB/b.bin" bs=1024 count=20 2> /dev/null
+    # shellcheck disable=SC2016  # the fake du expands these when it runs
+    mole_test_fake_command du 'case "$*" in *SlowCache*) exec sleep 10 ;; esac
+exec /usr/bin/du "$@"'
+    # 2 s rather than 1: get_path_size_kb turns its budget into a whole-second
+    # deadline, and with 1 a SECONDS tick between two of its lines could time
+    # out a fast path as well.
+    run_with_uninstall_functions MOLE_TIMEOUT_DISK_VERIFY_SEC=2 OUT="$BATS_TEST_TMPDIR/measured" << 'EOF'
+caches="$HOME/Library/Caches"
+rows=$(_batch_measure_leftovers "$(printf '%s\n' "$caches/FastA" "$caches/SlowCache" "$caches/FastB")")
+_batch_sum_leftover_rows "$rows" > "$OUT.total"
+mole_json_leftover_items "$rows" > "$OUT.json"
+EOF
+    [ "$status" -eq 0 ]
+    local a b
+    a=$(/usr/bin/du -skP "$caches/FastA" | awk '{print $1}')
+    b=$(/usr/bin/du -skP "$caches/FastB" | awk '{print $1}')
+    [ "$a" -gt 0 ]
+    [ "$b" -gt 0 ]
+    run jq -c '[.[] | [.size_kb, .size_known, .covered_by]]' "$BATS_TEST_TMPDIR/measured.json"
+    [ "$output" = "[[$a,true,null],[0,false,null],[$b,true,null]]" ]
+    run cat "$BATS_TEST_TMPDIR/measured.total"
+    [ "$output" -eq $((a + b)) ]
+}
