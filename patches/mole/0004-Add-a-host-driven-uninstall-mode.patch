             else
                 printf ',\n'
             fi
-            printf '  {"name": "%s", "bundle_id": "%s", "source": "%s", "uninstall_name": "%s", "path": "%s", "size": "%s"}' \
+            printf '  {"name": "%s", "bundle_id": "%s", "source": "%s", "uninstall_name": "%s", "path": "%s", "size": "%s", "size_kb": %s, "last_used_epoch": %s}' \
                 "$(uninstall_list_json_escape "$app_name")" \
