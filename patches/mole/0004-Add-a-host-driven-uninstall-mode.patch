+# Leftover discovery is replaced by exactly these paths: three leftovers,
+# plus one inside the first that is listed before it.
+create_fixture_with_nested_leftover() {
+    FIXTURE_APP="$HOME/Applications/RFMFixture.app"
+    create_fixture_app "$FIXTURE_APP" "com.example.rfmfixture" "RFMFixture"
+    SUPPORT="$HOME/Library/Application Support/RFMFixture"
+    NESTED="$SUPPORT/Nested"
+    CACHE="$HOME/Library/Caches/com.example.rfmfixture"
+    PREFS="$HOME/Library/Preferences/com.example.rfmfixture.plist"
+    mkdir -p "$NESTED" "$CACHE" "$HOME/Library/Preferences"
+    dd if=/dev/urandom of="$SUPPORT/state.bin" bs=1024 count=24 2> /dev/null
+    dd if=/dev/urandom of="$NESTED/blob.bin" bs=1024 count=16 2> /dev/null
+    dd if=/dev/urandom of="$CACHE/c.bin" bs=1024 count=40 2> /dev/null
+    printf 'prefs' > "$PREFS"
+    printf '%s\0' "$FIXTURE_APP" > "$PATHS_FILE"
+    OVERRIDES_FILE="$BATS_TEST_TMPDIR/overrides.sh"
+    cat > "$OVERRIDES_FILE" << 'SH'
+uninstall_live_bundle_has_other_install() { return 1; }
+find_app_files() {
+    printf '%s\n' \
+        "$HOME/Library/Application Support/RFMFixture/Nested" \
+        "$HOME/Library/Application Support/RFMFixture" \
+        "$HOME/Library/Caches/com.example.rfmfixture" \
+        "$HOME/Library/Preferences/com.example.rfmfixture.plist"
+}
+SH
+}
