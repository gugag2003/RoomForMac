From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Gustavo=20Gon=C3=A7alves?= <gugagon19@gmail.com>
Date: Fri, 25 Sep 2026 23:45:39 -0300
Subject: [PATCH] Add host integration helpers for GUI front ends

Adds lib/core/host.sh (JSON events, exact-path selections) and two
switches for GUI hosts: MOLE_NO_AUTH disables every sudo entry point and
MOLE_GUI_HOST skips the AppleScript quit in force_kill_app. All inert
unless the variables are set.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/core/app_protection.sh  |   5 +-
 lib/core/common.sh          |   1 +
 lib/core/host.sh            | 180 +++++++++++++++++++++++++
 lib/core/sudo.sh            |  19 ++-
 tests/host_integration.bats | 256 ++++++++++++++++++++++++++++++++++++
 5 files changed, 454 insertions(+), 7 deletions(-)
 create mode 100644 lib/core/host.sh
 create mode 100644 tests/host_integration.bats

diff --git a/lib/core/app_protection.sh b/lib/core/app_protection.sh
index d4973a90..99d06892 100644
--- a/lib/core/app_protection.sh
+++ b/lib/core/app_protection.sh
@@ -2195,7 +2195,10 @@ force_kill_app() {
     # flow (including unsaved-state prompts). osascript is best-effort: we
     # cap the wait so a hung app, an automation-permission dialog, or a
     # missing osascript binary can never stall the uninstall.
-    if [[ "${MOLE_TEST_MODE:-0}" != "1" && "${MOLE_TEST_NO_AUTH:-0}" != "1" ]] &&
+    # A GUI host (MOLE_GUI_HOST) quits apps through its own API before it runs
+    # the uninstall; an AppleScript Quit here would only add a per-app
+    # Automation permission prompt on the host's behalf.
+    if [[ "${MOLE_TEST_MODE:-0}" != "1" && "${MOLE_TEST_NO_AUTH:-0}" != "1" && -z "${MOLE_GUI_HOST:-}" ]] &&
         command -v osascript > /dev/null 2>&1; then
         local quit_target=""
         if mole_is_reverse_dns_bundle_id "$bundle_id"; then
